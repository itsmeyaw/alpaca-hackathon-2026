 .number { color: var(--mint); font-size: 1.55em; font-variant-numeric: tabular-nums; font-weight: 750; line-height: 0.9; }\n-      .metric-label { color: var(--muted); font-size: 0.36em; letter-spacing: 0.08em; margin-top: 0.45em; text-transform: uppercase; }\n-      .placeholder { color: #78a1c7; font-size: 0.6em; font-style: italic; }\n-      .result-callout { background: linear-gradient(120deg, rgba(95, 240, 176, 0.11), rgba(85, 182, 255, 0.1)); border: 1px solid rgba(95, 240, 176, 0.42); border-radius: 0.25em; margin-top: 0.45em; padding: 0.35em 0.55em; }\n+      .number { color: var(--black); font-family: BROmega, Arial, sans-serif; font-size: 1.45em; font-variant-numeric: tabular-nums; font-weight: 700; line-height: 0.9; }\n+      .metric-label { color: var(--muted); font-size: 0.34em; font-weight: 700; letter-spacing: 0.08em; margin-top: 0.45em; text-transform: uppercase; }\n+      .placeholder { color: var(--black); font-size: 0.58em; font-style: normal; }\n+      .result-callout { background: var(--yellow); border: 1.5px solid var(--black); border-radius: 0; margin-top: 0.45em; padding: 0.35em 0.55em; }\n       .result-callout p { font-size: 0.58em; margin: 0; }\n-      .result-callout strong { color: var(--mint); }\n \n       .closing { max-width: 17em; text-align: center; }\n       .closing h2 { font-size: 2.12em; }\n-      .closing p { color: #c3d2e4; }\n-      .closing .tagline { color: var(--mint); font-size: 0.68em; font-weight: 650; margin-top: 1em; }\n+      .closing p { color: var(--black); }\n+      .closing .tagline { border-top: 2px solid var(--black); font-size: 0.61em; font-weight: 700; margin-top: 1em; padding-top: 0.7em; }\n \n       @media (max-width: 700px) {\n         .three-up, .metrics, .service-grid { gap: 0.18em; }\n         .card { padding: 0.25em 0.3em; }\n         .architecture svg { max-height: 330px; }\n       }\n     </style>\n   </head>\n   <body>\n     <div class=\"reveal\">\n       <div class=\"slides\">\n-        <section class=\"center\" data-transition=\"fade\">\n+        <section class=\"center brand-cover\" data-transition=\"fade\">\n           <div>\n             <div class=\"eyebrow\">Alpaca Hackathon 2026</div>\n             <h1>Catalyst<br /><span class=\"accent\">Router</span></h1>\n             <div class=\"title-rule\"></div>\n             <p class=\"lede\">An autonomous paper-trading agent where AI finds a signal and deterministic systems protect the capital.</p>\n           </div>\n           <div class=\"title-footer\">XGBoost signals / Alpaca paper trading / Immutable decisions</div>\n         </section>\n \n         <section>\n           <h3>The Thesis</h3>\n           <h2>Make the model useful,<br />not <span class=\"accent\">all-powerful.</span></h2>\n           <p class=\"statement\">AI proposes direction and confidence. Deterministic code owns every dollar of risk.</p>\n           <div class=\"three-up\">\n             <div class=\"card mint\">\n               <div class=\"label\">Observe</div>\n               <div class=\"value\">Dynamic universe</div>\n               <div class=\"detail\">Liquid equities, IEX prices, and fresh market context.</div>\n             </div>\n             <div class=\"card blue\">\n               <div class=\"label\">Decide</div>\n               <div class=\"value\">Long / short / abstain</div>\n               <div class=\"detail\">XGBoost scores completed 15-minute bars.</div>\n             </div>\n             <div class=\"card coral\">\n               <div class=\"label\">Govern</div>\n               <div class=\"value\">Risk first</div>\n               <div class=\"detail\">The model cannot size, submit, or bypass a veto.</div>\n             </div>\n           </div>\n         </section>\n \n         <section>\n           <h3>Model Architecture</h3>\n           <h2>One narrow path to an order.</h2>\n           <div class=\"architecture\">\n             <pre class=\"mermaid\">\n flowchart LR\n   subgraph A[Alpaca]\n     MD[IEX bars + quotes]\n     N[News]\n     PT[Paper Trading]\n   end\n   subgraph C[Catalyst Router]\n     U[Dynamic universe]\n     M[XGBoost classifier]\n     R[Risk Governor]\n     E[Idempotent execution]\n     L[(Decision ledger)]\n   end\n   MD --> U --> M\n   M -->|Long / Short / Abstain| R\n   R -->|Approved only| E --> PT\n   PT -->|Reconcile| E\n   N -. shadow event evidence .-> L\n   M --> L\n   R --> L\n   E --> L\n             </pre>\n           </div>\n           <p class=\"architecture-note\">The XGBoost model can propose a trade. Only the Risk Governor can approve an Alpaca order.</p>\n         </section>\n \n         <section>\n           <h3>Alpaca, End To End</h3>\n           <h2>Alpaca is the market interface<br />and the <span class=\"accent\">source of truth.</span></h2>\n           <div class=\"service-grid\">\n             <div class=\"card mint\">\n               <div class=\"label\">Market Data API</div>\n               <div class=\"value\">IEX bars, quotes, screeners</div>\n               <div class=\"detail\">Point-in-time model features plus freshness and spread gates.</div>\n             </div>\n             <div class=\"card blue\">\n               <div class=\"label\">News API</div>\n               <div class=\"value\">Catalyst evidence</div>\n               <div class=\"detail\">Symbol news feeds a shadow-only Bedrock event extractor.</div>\n             </div>\n             <div class=\"card coral\">\n               <div class=\"label\">Paper Trading API</div>\n               <div class=\"value\">Brackets and reconciliation</div>\n               <div class=\"detail\">Broker-hosted exits; account, order, and P&amp;L authority.</div>\n             </div>\n             <div class=\"card\">\n               <div class=\"label\">alpaca-py + CLI</div>\n               <div class=\"value\">Typed runtime and safe demo</div>\n               <div class=\"detail\">Python worker executes; CLI supports read-only diagnostics and dry runs.</div>\n             </div>\n           </div>\n         </section>\n \n         <section>\n           <h3>Built To Survive</h3>\n           <h2>Every trade must earn<br />permission to exist.</h2>\n           <div class=\"three-up\">\n             <div class=\"card mint\">\n               <div class=\"label\">Market gates</div>\n               <div class=\"value\">Freshness, spread, hours</div>\n               <div class=\"detail\">Bad or stale data resolves to no trade.</div>\n             </div>\n             <div class=\"card blue\">\n               <div class=\"label\">Portfolio limits</div>\n               <div class=\"value\">1% risk per trade</div>\n               <div class=\"detail\">Six positions max, 5% total stop-risk.</div>\n             </div>\n             <div class=\"card coral\">\n               <div class=\"label\">Failure containment</div>\n               <div class=\"value\">Brackets + circuit breakers</div>\n               <div class=\"detail\">Risk halt at 4% daily loss; kill at 12% drawdown.</div>\n             </div>\n           </div>\n           <div class=\"result-callout\"><p><strong>Auditable by design:</strong> immutable decisions, idempotent order claims, and Alpaca reconciliation after every restart.</p></div>\n         </section>\n \n         <section>\n           <h3>Results</h3>\n           <h2>Paper-trading performance.</h2>\n           <!-- Replace the bracketed placeholders with final competition data before presenting. -->\n           <div class=\"metrics\">\n             <div class=\"card\">\n               <div class=\"number placeholder\">[+$X,XXX]</div>\n               <div class=\"metric-label\">Net P&amp;L</div>\n             </div>\n             <div class=\"card\">\n               <div class=\"number placeholder\">[+X.XX%]</div>\n               <div class=\"metric-label\">Return</div>\n             </div>\n             <div class=\"card\">\n               <div class=\"number placeholder\">[XX]</div>\n               <div class=\"metric-label\">Closed Trades</div>\n             </div>\n             <div class=\"card\">\n               <div class=\"number placeholder\">[X.XX%]</div>\n               <div class=\"metric-label\">Max Drawdown</div>\n             </div>\n           </div>\n           <div class=\"result-callout\">\n             <p><strong>What changed the curve?</strong> [Add one concise insight: best route, a risk veto that mattered, or a representative trade.]</p>\n           </div>\n           <p class=\"muted\" style=\"font-size: 0.47em; margin-top: 0.7em;\">Optional proof point: [equity-curve screenshot, Alpaca dashboard image, or one decision record]</p>\n         </section>\n \n-        <section class=\"center\" data-transition=\"fade\">\n+        <section class=\"center brand-cover\" data-transition=\"fade\">\n           <div class=\"closing\">\n             <div class=\"eyebrow\">Catalyst Router</div>\n             <h2>Intelligence with<br /><span class=\"accent\">boundaries.</span></h2>\n             <p>We are not asking an LLM to trade. We are building a verifiable system that uses models where they help and controls where they matter.</p>\n             <p class=\"tagline\">AI proposes. Deterministic code disposes. Alpaca reconciles.</p>\n           </div>\n         </section>\n       </div>\n     </div>\n \n     <script src=\"https://cdn.jsdelivr.net/npm/reveal.js@5.1.0/dist/reveal.js\"></script>\n     <script type=\"module\">\n       import mermaid from \"https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs\";\n \n       mermaid.initialize({\n         startOnLoad: false,\n         theme: \"base\",\n         themeVariables: {\n-          primaryColor: \"#dceeff\",\n-          primaryTextColor: \"#102035\",\n-          primaryBorderColor: \"#55b6ff\",\n-          lineColor: \"#3d668f\",\n-          secondaryColor: \"#d8fae9\",\n-          tertiaryColor: \"#eef5ff\",\n-          clusterBkg: \"#f7fbff\",\n-          clusterBorder: \"#89a9ca\",\n-          fontFamily: \"Inter, system-ui, sans-serif\"\n+          primaryColor: \"#fcd72b\",\n+          primaryTextColor: \"#000000\",\n+          primaryBorderColor: \"#000000\",\n+          lineColor: \"#000000\",\n+          secondaryColor: \"#ffffff\",\n+          tertiaryColor: \"#f2f0eb\",\n+          clusterBkg: \"#fbfaf7\",\n+          clusterBorder: \"#000000\",\n+          fontFamily: \"Arial, sans-serif\"\n         },\n         flowchart: { curve: \"basis\", htmlLabels: true }\n       });\n \n       Reveal.initialize({\n         controls: true,\n         controlsLayout: \"bottom-right\",\n         hash: true,\n         progress: true,\n         slideNumber: \"c/t\",\n         transition: \"slide\",\n         transitionSpeed: \"fast\",\n         center: false,\n         width: 1280,\n         height: 720,\n         margin: 0.08\n       });\n \n       async function renderDiagram(slide) {\n         const diagram = slide.querySelector(\".mermaid:not([data-processed])\");\n         if (diagram) {\n           await mermaid.run({ nodes: [diagram] });\n         }\n       }\n \n       Reveal.on(\"ready\", (event) => renderDiagram(event.currentSlide));\n       Reveal.on(\"slidechanged\", (event) => renderDiagram(event.currentSlide));\n     </script>\n   </body>\n </html>\n",
