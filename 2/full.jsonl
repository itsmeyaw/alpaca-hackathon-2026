50; line-height: 1.15; margin-top: 0.22em; }\n58:       .card .detail { color: #afc0d4; font-size: 0.42em; line-height: 1.24; margin-top: 0.25em; }\n59:       .card.mint { border-color: rgba(95, 240, 176, 0.5); }\n60:       .card.blue { border-color: rgba(85, 182, 255, 0.5); }\n61:       .card.coral { border-color: rgba(255, 139, 120, 0.5); }\n62: \n63:       .architecture { margin-top: 0.22em; }\n64:       .architecture .mermaid { background: #f5f9ff; border-radius: 0.22em; padding: 0.22em; }\n65:       .architecture svg { max-height: 415px; max-width: 100%; }\n66:       .architecture-note { color: var(--muted); font-size: 0.42em !important; margin-top: 0.4em !important; text-align: center; }\n67: \n68:       .number { color: var(--mint); font-size: 1.55em; font-variant-numeric: tabular-nums; font-weight: 750; line-height: 0.9; }\n69:       .metric-label { color: var(--muted); font-size: 0.36em; letter-spacing: 0.08em; margin-top: 0.45em; text-transform: uppercase; }\n70:       .placeholder { color: #78a1c7; font-size: 0.6em; font-style: italic; }\n71:       .result-callout { background: linear-gradient(120deg, rgba(95, 240, 176, 0.11), rgba(85, 182, 255, 0.1)); border: 1px solid rgba(95, 240, 176, 0.42); border-radius: 0.25em; margin-top: 0.45em; padding: 0.35em 0.55em; }\n72:       .result-callout p { font-size: 0.58em; margin: 0; }\n73:       .result-callout strong { color: var(--mint); }\n74: \n75:       .closing { max-width: 17em; text-align: center; }\n76:       .closing h2 { font-size: 2.12em; }\n77:       .closing p { color: #c3d2e4; }\n78:       .closing .tagline { color: var(--mint); font-size: 0.68em; font-weight: 650; margin-top: 1em; }\n79: \n80:       @media (max-width: 700px) {\n81:         .three-up, .metrics, .service-grid { gap: 0.18em; }\n82:         .card { padding: 0.25em 0.3em; }\n83:         .architecture svg { max-height: 330px; }\n84:       }\n85:     </style>\n86:   </head>\n87:   <body>\n88:     <div class=\"reveal\">\n89:       <div class=\"slides\">\n90:         <section class=\"center\" data-transition=\"fade\">\n91:           <div>\n92:             <div class=\"eyebrow\">Alpaca Hackathon 2026</div>\n93:             <h1>Catalyst<br /><span class=\"accent\">Router</span></h1>\n94:             <div class=\"title-rule\"></div>\n95:             <p class=\"lede\">An autonomous paper-trading agent where AI finds a signal and deterministic systems protect the capital.</p>\n96:           </div>\n97:           <div class=\"title-footer\">XGBoost signals / Alpaca paper trading / Immutable decisions</div>\n98:         </section>\n99: \n100:         <section>\n101:           <h3>The Thesis</h3>\n102:           <h2>Make the model useful,<br />not <span class=\"accent\">all-powerful.</span></h2>\n103:           <p class=\"statement\">AI proposes direction and confidence. Deterministic code owns every dollar of risk.</p>\n104:           <div class=\"three-up\">\n105:             <div class=\"card mint\">\n106:               <div class=\"label\">Observe</div>\n107:               <div class=\"value\">Dynamic universe</div>\n108:               <div class=\"detail\">Liquid equities, IEX prices, and fresh market context.</div>\n109:             </div>\n110:             <div class=\"card blue\">\n111:               <div class=\"label\">Decide</div>\n112:               <div class=\"value\">Long / short / abstain</div>\n113:               <div class=\"detail\">XGBoost scores completed 15-minute bars.</div>\n114:             </div>\n115:             <div class=\"card coral\">\n116:               <div class=\"label\">Govern</div>\n117:               <div class=\"value\">Risk first</div>\n118:               <div class=\"detail\">The model cannot size, submit, or bypass a veto.</div>\n119:             </div>\n120:           </div>\n121:         </section>\n122: \n123:         <section>\n124:           <h3>Model Architecture</h3>\n125:           <h2>One narrow path to an order.</h2>\n126:           <div class=\"architecture\">\n127:             <pre class=\"mermaid\">\n128: flowchart LR\n129:   subgraph A[Alpaca]\n130:     MD[IEX bars + quotes]\n131:     N[News]\n132:     PT[Paper Trading]\n133:   end\n134:   subgraph C[Catalyst Router]\n135:     U[Dynamic universe]\n136:     M[XGBoost classifier]\n137:     R[Risk Governor]\n138:     E[Idempotent execution]\n139:     L[(Decision ledger)]\n140:   end\n141:   MD --> U --> M\n142:   M -->|Long / Short / Abstain| R\n143:   R -->|Approved only| E --> PT\n144:   PT -->|Reconcile| E\n145:   N -. shadow event evidence .-> L\n146:   M --> L\n147:   R --> L\n148:   E --> L\n149:             </pre>\n150:           </div>\n151:           <p class=\"architecture-note\">The XGBoost model can propose a trade. Only the Risk Governor can approve an Alpaca order.</p>\n152:         </section>\n153: \n154:         <section>\n155:           <h3>Alpaca, End To End</h3>\n156:           <h2>Alpaca is the market interface<br />and the <span class=\"accent\">source of truth.</span></h2>\n157:           <div class=\"service-grid\">\n158:             <div class=\"card mint\">\n159:               <div class=\"label\">Market Data API</div>\n160:               <div class=\"value\">IEX bars, quotes, screeners</div>\n161:               <div class=\"detail\">Point-in-time model features plus freshness and spread gates.</div>\n162:             </div>\n163:             <div class=\"card blue\">\n164:               <div class=\"label\">News API</div>\n165:               <div class=\"value\">Catalyst evidence</div>\n166:               <div class=\"detail\">Symbol news feeds a shadow-only Bedrock event extractor.</div>\n167:             </div>\n168:             <div class=\"card coral\">\n169:               <div class=\"label\">Paper Trading API</div>\n170:               <div class=\"value\">Brackets and reconciliation</div>\n171:               <div class=\"detail\">Broker-hosted exits; account, order, and P&amp;L authority.</div>\n172:             </div>\n173:             <div class=\"card\">\n174:               <div class=\"label\">alpaca-py + CLI</div>\n175:               <div class=\"value\">Typed runtime and safe demo</div>\n176:               <div class=\"detail\">Python worker executes; CLI supports read-only diagnostics and dry runs.</div>\n177:             </div>\n178:           </div>\n179:         </section>\n180: \n181:         <section>\n182:           <h3>Built To Survive</h3>\n183:           <h2>Every trade must earn<br />permission to exist.</h2>\n184:           <div class=\"three-up\">\n185:             <div class=\"card mint\">\n186:               <div class=\"label\">Market gates</div>\n187:               <div class=\"value\">Freshness, spread, hours</div>\n188:               <div class=\"detail\">Bad or stale data resolves to no trade.</div>\n189:             </div>\n190:             <div class=\"card blue\">\n191:               <div class=\"label\">Portfolio limits</div>\n192:               <div class=\"value\">1% risk per trade</div>\n193:               <div class=\"detail\">Six positions max, 5% total stop-risk.</div>\n194:             </div>\n195:             <div class=\"card coral\">\n196:               <div class=\"label\">Failure containment</div>\n197:               <div class=\"value\">Brackets + circuit breakers</div>\n198:               <div class=\"detail\">Risk halt at 4% daily loss; kill at 12% drawdown.</div>\n199:             </div>\n200:           </div>\n201:           <div class=\"result-callout\"><p><strong>Auditable by design:</strong> immutable decisions, idempotent order claims, and Alpaca reconciliation after every restart.</p></div>\n202:         </section>\n203: \n204:         <section>\n205:           <h3>Results</h3>\n206:           <h2>Paper-trading performance.</h2>\n207:           <!-- Replace the bracketed placeholders with final competition data before presenting. -->\n208:           <div class=\"metrics\">\n209:             <div class=\"card\">\n210:               <div class=\"number placeholder\">[+$X,XXX]</div>\n211:               <div class=\"metric-label\">Net P&amp;L</div>\n212:             </div>\n213:             <div class=\"card\">\n214:               <div class=\"number placeholder\">[+X.XX%]</div>\n215:               <div class=\"metric-label\">Return</div>\n216:             </div>\n217:             <div class=\"card\">\n218:               <div class=\"number placeholder\">[XX]</div>\n219:               <div class=\"metric-label\">Closed Trades</div>\n220:             </div>\n221:             <div class=\"card\">\n222:               <div class=\"number placeholder\">[X.XX%]</div>\n223:               <div class=\"metric-label\">Max Drawdown</div>\n224:             </div>\n225:           </div>\n226:           <div class=\"result-callout\">\n227:             <p><strong>What changed the curve?</strong> [Add one concise insight: best route, a risk veto that mattered, or a representative trade.]</p>\n228:           </div>\n229:           <p class=\"muted\" style=\"font-size: 0.47em; margin-top: 0.7em;\">Optional proof point: [equity-curve screenshot, Alpaca dashboard image, or one decision record]</p>\n230:         </section>\n231: \n232:         <section class=\"center\" data-transition=\"fade\">\n233:           <div class=\"closing\">\n234:             <div class=\"eyebrow\">Catalyst Router</div>\n235:             <h2>Intelligence with<br /><span class=\"accent\">boundaries.</span></h2>\n236:             <p>We are not asking an LLM to trade. We are building a verifiable system that uses models where they help and controls where they matter.</p>\n237:             <p class=\"tagline\">AI proposes. Deterministic code disposes. Alpaca reconciles.</p>\n238:           </div>\n239:         </section>\n240:       </div>\n241:     </div>\n242: \n243:     <script src=\"https://cdn.jsdelivr.net/npm/reveal.js@5.1.0/dist/reveal.js\"></script>\n244:     <script type=\"module\">\n245:       import mermaid from \"https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs\";\n246: \n247:       mermaid.initialize({\n248:         startOnLoad: false,\n249:         theme: \"base\",\n250:         themeVariables: {\n251:           primaryColor: \"#dceeff\",\n252:           primaryTextColor: \"#102035\",\n253:           primaryBorderColor: \"#55b6ff\",\n254:           lineColor: \"#3d668f\",\n255:           secondaryColor: \"#d8fae9\",\n256:           tertiaryColor: \"#eef5ff\",\n257:           clusterBkg: \"#f7fbff\",\n258:           clusterBorder: \"#89a9ca\",\n259:           fontFamily: \"Inter, system-ui, sans-serif\"\n260:         },\n261:         flowchart: { curve: \"basis\", htmlLabels: true }\n262:       });\n263: \n264:       Reveal.initialize({\n265:         controls: true,\n266:         controlsLayout: \"bottom-right\",\n267:         hash: true,\n268:         progress: true,\n269:         slideNumber: \"c/t\",\n270:         transition: \"slide\",\n271:         transitionSpeed: \"fast\",\n272:         center: false,\n273:         width: 1280,\n274:         height: 720,\n275:         margin: 0.08\n276:       });\n277: \n278:       async function renderDiagram(slide) {\n279:         const diagram = slide.querySelector(\".mermaid:not([data-processed])\");\n280:         if (diagram) {\n281:           await mermaid.run({ nodes: [diagram] });\n282:         }\n283:       }\n284: \n285:       Reveal.on(\"ready\", (event) => renderDiagram(event.currentSlide));\n286:       Reveal.on(\"slidechanged\", (event) => renderDiagram(event.currentSlide));\n287:     </script>\n288:   </body>\n289: </html>\n\n(End of file - total 289 lines)\n</content>",
