/iframe></noscript>\n    <!-- End Google Tag Manager (noscript) -->\n    <header>\n      \n      <!--\n  theme = \"primary\" | \"dark\" | \"dynamic\"\n\n  The dynamic theme will auto-adjust based on the color of the page content being scrolled over.\n\n  In dynamic mode:\n    - *Only* elements matching the following selectors will be checked:\n\n      section.section\n      section.bgcolor\n      .footer\n\n    - All triggering elements *must* have a defined background-color.\n\n  The classes used in dynamic mode are the same as those used by the navigation bar's coloring logic, so both this banner and the navigation bar will need to have their behaviours checked when a dynamic banner is added.\n-->\n\n<div\n  id=\"top-banner\"\n  style=\"display: none; justify-content: center; align-items: center; position: fixed; top: 0; left: 0; z-index: 21; width: 100%; height: 38px; margin: 0; padding: 0; transition: all 300ms ease-in-out;\"\n  class=\"bg-gray-100\"\n>\n  <p\n    style=\"margin: 0; padding: 0 40px 0 4px; font-size: 16px; text-align: center; line-height: 38px;\"\n    class=\"!text-white\"\n  >\n    <span id=\"top-banner-mobile-copy\" style=\"display: none;\">\n      Want to trade using AI? We launched Alpaca's MCP Server to help you trade with natural language.\n      <a\n        style=\"text-decoration: underline; font-weight: bold; padding: 0 2px 0 4px; color: inherit;\"\n        href=\"https://alpaca.markets/mcp-server\"\n        data-amp-evt=\"cta\"\n        data-amp-position=\"top_banner\"\n      >Learn more</a>\n    </span>\n    <span id=\"top-banner-copy\">\n      Want to trade using AI? We launched Alpaca's MCP Server to help you trade with natural language.\n      <a\n         style=\"text-decoration: underline; font-weight: bold; padding: 0 2px; color: inherit;\"\n         href=\"https://alpaca.markets/mcp-server\"\n         data-amp-evt=\"cta\"\n         data-amp-position=\"top_banner\"\n       >Learn more</a>\n    </span>\n  </p>\n  <button\n    id=\"top-banner-close\"\n    style=\"position: absolute; top: 7px; right: 10px; cursor: pointer; font-size: 20px;\"\n    class=\"!text-white\"\n  >&times;</button>\n  <script>\n      const isDynamicTheme = \"dark\" === \"dynamic\";\n\n      window.addEventListener(\"DOMContentLoaded\", function () {\n        const key = \"_20_11_25_tbs\";\n\n        const showBanner = typeof window.localStorage !== \"undefined\"\n           ? window.localStorage.getItem(key)\n              ? false\n              : true\n           : false;\n\n        if (showBanner) {\n          window.addEventListener(\"resize\", handleScreenSize);\n          handleScreenSize();\n\n          if (isDynamicTheme) {\n            window.addEventListener(\"scroll\", handleBGColor);\n            handleBGColor();\n          }\n\n          const nav = document.getElementsByClassName(\"navi\")?.item(0);\n          const body = document.getElementsByTagName(\"body\")?.item(0);\n          const banner = document.getElementById(\"top-banner\");\n          const closeButton = document.getElementById(\"top-banner-close\");\n\n          if (nav && body && banner && closeButton) {\n            body.style.position = \"relative\";\n            body.style.top = \"38px\";\n            nav.classList.add(\"navi--with-banner\");\n            nav.classList.add(\"navi--perma-shrink\");\n            banner.style.display = \"flex\";\n            banner.style.opacity = \"1\";\n            closeButton.addEventListener(\"click\", closeBanner);\n          }\n        }\n\n        function closeBanner() {\n          const nav = document.getElementsByClassName(\"navi\").item(0);\n          nav.classList.remove(\"navi--with-banner\");\n          nav.classList.remove(\"navi--perma-shrink\");\n          document.getElementById(\"top-banner\").style.display = \"none\";\n          const body = document.getElementsByTagName(\"body\")?.item(0);\n          body.style.top = \"0px\";\n\n          if (typeof window.localStorage !== \"undefined\") {\n            window.localStorage.setItem(key, \"1\");\n          }\n\n          document\n            .getElementById(\"top-banner-close\")\n            .removeEventListener(\"click\", closeBanner);\n        }\n\n        function handleScreenSize(evt) {\n          const width = window.innerWidth;\n          const p = document.querySelector(\"#top-banner p\");\n          const mobileCopy = document.querySelector(\"#top-banner-mobile-copy\");\n          const copy = document.querySelector(\"#top-banner-copy\");\n\n          if (width > 900) {\n            p.style.fontSize = \"16px\";\n            p.style.lineHeight = \"20px\";\n          }\n          if (width <= 900) {\n            p.style.fontSize = \"12px\";\n            p.style.lineHeight = \"16px\";\n          }\n          if (width <= 660) {\n            p.style.fontSize = \"10px\";\n            p.style.lineHeight = \"14px\";\n          }\n          if (width <= 646) {\n            copy.style.display = \"none\";\n            mobileCopy.style.display = \"inline\";\n          } else {\n            copy.style.display = \"inline\";\n            mobileCopy.style.display = \"none\";\n          }\n        }\n\n        function handleBGColor() {\n          const elements = document.querySelectorAll(\n            \"section.section, section.bgcolor, .footer\"\n          );\n          const nav = document.querySelector(\".navi\");\n          const banner = document.getElementById(\"top-banner\");\n          const p = banner.querySelector(\"p\");\n          const aTags = banner.querySelectorAll(\"a\");\n          const closeButton = document.getElementById(\"top-banner-close\");\n          if (!nav || !banner || !p || !aTags || !closeButton) return;\n\n          for (let i = 0; i < elements.length; i++) {\n            const element = elements.item(i);\n            const navHeight = nav.offsetHeight;\n            const top =\n              element.getBoundingClientRect().top +\n              window.pageYOffset -\n              document.documentElement.clientTop -\n              navHeight;\n            const bottom = top + element.offsetHeight;\n\n            if (window.scrollY >= top && window.scrollY <= bottom) {\n              const bgColor = getComputedStyle(element)[\"background-color\"];\n              switch (bgColor) {\n                case \"rgb(252, 215, 43)\":\n                case \"rgb(255, 215, 0)\":\n                case \"rgb(255, 247, 204)\":\n                case \"rgb(254, 247, 208)\":\n                case \"rgb(255, 240, 153)\":\n                case \"rgb(244, 237, 227)\":\n                  banner.style.backgroundColor = \"#000\";\n                  p.style.color = \"#fff\";\n                  aTags.forEach(function (a) { a.style.color = \"#fff\"; });\n                  closeButton.style.color = \"#fff\";\n                  return;\n                default:\n                  banner.style.backgroundColor = \"#fcd72b\";\n                  p.style.color = \"#000\";\n                  aTags.forEach(function (a) { a.style.color = \"#000\"; });\n                  closeButton.style.color = \"#000\";\n                  return;\n              }\n            }\n          }\n        }\n      });\n    </script>\n</div>\n\n      \n      \n      <nav class=\"navi navi--yellow \">\n  <ul class=\"navi__container\">\n    \n    <li class=\"navi__logo\">\n      <a href=\"/\">\n  <svg\n    width=\"152\"\n    height=\"44\"\n    viewBox=\"0 0 152 44\"\n    fill=\"none\"\n    xmlns=\"http://www.w3.org/2000/svg\"\n  >\n    <title>Alpaca</title>\n    <desc>http://alpaca.markets/</desc>\n    <path\n      class=\"navi__logo__letter\"\n      d=\"M68.8585 32.3337L67.4321 28.0499H58.3032L56.8771 32.3337H52.7246L60.6171 9.44263H65.1182L73.0107 32.3337H68.8585ZM59.4445 24.5181H66.2911L62.9311 14.3806H62.8043L59.4445 24.5181Z\"\n      fill=\"white\"\n    />\n    <path\n      class=\"navi__logo__letter\"\n      d=\"M75.2332 32.3337V9.44263H79.0367V32.3337H75.2332Z\"\n      fill=\"white\"\n    